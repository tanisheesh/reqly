{
  "name": "reqly-node",
  "version": "0.6.0",
  "description": "Reqly SDK for Node.js: per-route latency, errors, consumers and LLM cost for Express, Fastify, Hono, Koa, NestJS and plain node:http, sent to a self-hosted Reqly collector.",
  "license": "MIT",
  "author": "Tanish Poddar",
  "homepage": "https://reqly.tanisheesh.in/docs/instrument/node/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanisheesh/reqly.git",
    "directory": "sdk-node"
  },
  "keywords": [
    "apm",
    "observability",
    "express",
    "fastify",
    "hono",
    "koa",
    "nestjs",
    "latency",
    "monitoring",
    "reqly",
    "serverless",
    "edge",
    "cloudflare-workers",
    "nextjs",
    "vercel"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./edge": {
      "import": {
        "types": "./dist/esm/edge.d.ts",
        "default": "./dist/esm/edge.js"
      },
      "require": {
        "types": "./dist/cjs/edge.d.ts",
        "default": "./dist/cjs/edge.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/cjs-package.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/swagger": "^9.9.2",
    "@koa/router": "^15.7.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "express": "^5.1.0",
    "express4": "npm:express@^4.22.3",
    "fastify": "^5.2.0",
    "fastify4": "npm:fastify@^4.29.1",
    "hono": "^4.7.0",
    "koa": "^3.2.1",
    "openai": "^7.39.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  }
}
