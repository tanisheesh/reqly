# Copy to .env and adjust as needed. docker-compose.yml falls back to the
# defaults shown here even if .env doesn't exist, so `docker-compose up`
# works out of the box -- these are only needed to override.

# TimescaleDB
POSTGRES_PASSWORD=localdev

# SDK ingest key -- sent by the SDK as X-Reqly-Key on every /v1/ingest call
REQLY_INGEST_KEY=demo-key

# Dashboard read key -- sent by the browser dashboard to read metrics/insights.
# It is compiled into the dashboard's JavaScript, so treat it as PUBLIC to
# anyone who can open the dashboard. It must differ from REQLY_INGEST_KEY
# (the collector warns at startup if they match), otherwise dashboard
# viewers can also write telemetry.
REQLY_READ_KEY=demo-read-key
# Dashboard sign-in. PUBLIC_DASHBOARD=true lets anyone with the dashboard (and its
# public read key) read everything -- fine for a demo. Set it to false and set
# REQLY_ADMIN_PASSWORD (12+ chars) to create the first admin on start-up.
PUBLIC_DASHBOARD=true
REQLY_ADMIN_USERNAME=admin
REQLY_ADMIN_PASSWORD=

# AI Insights -- get a free key at https://console.groq.com/keys
# If left blank, the AI Insights panel falls back to a plain-text summary of
# the statistical findings instead of an LLM-written report.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Collector CORS (comma-separated origins, or * for the local demo)
CORS_ORIGINS=*

# Set to false if the SAM Lambda (infra/sam) runs the weekly insights job,
# so the report isn't generated twice every Sunday.
INSIGHTS_SCHEDULER_ENABLED=true

# How often (seconds) the collector materializes late-arriving events --
# backfills, SDK retries after an outage -- into the continuous aggregates.
LATE_DATA_REFRESH_SECONDS=60

# Hourly anomaly alerts. The check runs every hour at :15 and open alerts
# show on the dashboard; notifications go only to the channels set here.
ALERTS_ENABLED=true
ALERT_SLACK_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
# Generic JSON webhook: {"event": "alert.opened|alert.still_firing|alert.resolved", "text": ..., "alert": {...}}
ALERT_WEBHOOK_URL=
ALERT_RENOTIFY_HOURS=6
# LLM cost alerts: the smallest extra spend per route-hour (USD) worth an alert;
# 0 turns them off. The collector's default is 1.0; this demo stack uses 0.4 so the
# load generator's prompt-bloat scenario shows up.
LLM_COST_ALERT_MIN_USD=0.4
# Linked from Slack alerts
DASHBOARD_URL=http://localhost:5173

# Behind a reverse proxy / load balancer, set this to the proxy's IP (or *
# if the collector is ONLY reachable through the proxy) so rate limiting
# keys on the real client IP from X-Forwarded-For instead of the proxy's.
# Read by uvicorn directly.
FORWARDED_ALLOW_IPS=127.0.0.1

# API consumers: distinct consumer ids kept per service per UTC day; later new
# ones are stored as "__other__" (protects against a request id passed as the
# consumer). 0 turns the cap off.
CONSUMER_LIMIT_PER_DAY=1000

# Dashboard: collector URL as seen from the BROWSER (not the Docker
# network), since the dashboard is a static SPA served to your host browser.
VITE_COLLECTOR_URL=http://localhost:8000

# Load generator: how much synthetic history to backfill on first run.
BACKFILL_WEEKS=8
BACKFILL_EVENTS_PER_HOUR=30
